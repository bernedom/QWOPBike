use flake

nix_state="${IN_NIX_SHELL:-false}"
venv_state="${VIRTUAL_ENV:-false}"

print_status() {
  label="$1"
  value="$2"

  if [ "$value" = "false" ]; then
    color="\033[0;31m"   # dark red
  else
    color="\033[1;92m"   # lime/bright green
  fi

  printf "%b%s: %s%b\n" "$color" "$label" "$value" "\033[0m"
}


print_status "In NIX shell" "$nix_state"
print_status "In virtual environment" "$venv_state"
